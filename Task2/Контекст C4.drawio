<mxfile host="app.diagrams.net">
    <diagram name="C4 — контекст MVP">
        <mxGraphModel page="1" pageScale="1" pageWidth="1800" pageHeight="1200" grid="1" gridSize="10">
            <root>
                <mxCell id="0" />
                <mxCell id="1" parent="0" />
                <mxCell id="title" value="C4 / System Context — Медикаменте&#10;MVP записи и границы развития" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;shape=rectangle;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1">
                    <mxGeometry x="70" y="20" width="1600" height="100" as="geometry" />
                </mxCell>
                <mxCell id="patient" value="Пациент&#10;[Person]&#10;Записывается, видит свои записи" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=0;fillColor=#f5eee1;strokeColor=#786448;" vertex="1" parent="1">
                    <mxGeometry x="60" y="200" width="300" height="140" as="geometry" />
                </mxCell>
                <mxCell id="staff" value="Ресепшен и врач&#10;[Person]&#10;Работают по роли и назначению" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=0;fillColor=#f5eee1;strokeColor=#786448;" vertex="1" parent="1">
                    <mxGeometry x="60" y="570" width="300" height="140" as="geometry" />
                </mxCell>
                <mxCell id="system" value="Медикаменте: система записи&#10;[Software System]&#10;Порталы, расписание, контакты&#10;Серверная политика доступа&#10;Каталог и политики; аудит и мониторинг" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=1;arcSize=8;fillColor=#eaf0f5;strokeColor=#456078;" vertex="1" parent="1">
                    <mxGeometry x="650" y="360" width="470" height="220" as="geometry" />
                </mxCell>
                <mxCell id="iam" value="AD + IAM&#10;[External System]&#10;Сотрудники / пациентские аккаунты" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=1;arcSize=8;fillColor=#eaf0f5;strokeColor=#456078;" vertex="1" parent="1">
                    <mxGeometry x="1380" y="140" width="350" height="150" as="geometry" />
                </mxCell>
                <mxCell id="legacy" value="1С и файловый архив&#10;[External System]&#10;Учёт, документы и медкарты" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=1;arcSize=8;fillColor=#eaf0f5;strokeColor=#456078;" vertex="1" parent="1">
                    <mxGeometry x="1380" y="420" width="350" height="150" as="geometry" />
                </mxCell>
                <mxCell id="notify" value="Каналы уведомлений&#10;[External System]&#10;Пациенту и специалисту&#10;за сутки" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=1;arcSize=8;fillColor=#eaf0f5;strokeColor=#456078;" vertex="1" parent="1">
                    <mxGeometry x="1380" y="740" width="350" height="150" as="geometry" />
                </mxCell>
                <mxCell id="analyst" value="Аналитик&#10;[Person]&#10;Только разрешённая витрина" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=0;fillColor=#f5eee1;strokeColor=#786448;" vertex="1" parent="1">
                    <mxGeometry x="60" y="940" width="300" height="140" as="geometry" />
                </mxCell>
                <mxCell id="analytics" value="Защищённая аналитика&#10;[Software System]&#10;Минимальная витрина в MVP;&#10;озеро/BI/ML поэтапно" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=1;arcSize=8;fillColor=#eaf0f5;strokeColor=#456078;" vertex="1" parent="1">
                    <mxGeometry x="650" y="900" width="470" height="180" as="geometry" />
                </mxCell>
                <mxCell id="future" value="Далее, до года: мобильное приложение, CRM, лабораторный API и платёжный шлюз.&#10;Это развитие контекста, не условие готовности двухмесячного MVP. Хранение и обработка — в инфраструктуре РФ." style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;shape=rectangle;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1">
                    <mxGeometry x="60" y="1100" width="1670" height="80" as="geometry" />
                </mxCell>
                <mxCell id="e0" value="HTTPS: своя запись&#10;и минимальные контакты" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=17;labelBackgroundColor=#ffffff;spacing=5;" edge="1" parent="1" source="patient" target="system">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="e1" value="HTTPS: расписание&#10;по правам и филиалу" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=17;labelBackgroundColor=#ffffff;spacing=5;" edge="1" parent="1" source="staff" target="system">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="e2" value="Аутентификация&#10;и роли" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=17;labelBackgroundColor=#ffffff;spacing=5;exitX=0.85;exitY=0;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="system" target="iam">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1049.5" y="215" />
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e3" value="Через адаптеры legacy&#10;ID и статус; без медкарт" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=17;labelBackgroundColor=#ffffff;spacing=5;exitX=1;exitY=0.5;entryX=0;entryY=0.3333333333333333;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="system" target="legacy">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="e4" value="Контакт и время приёма;&#10;без диагноза" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=17;labelBackgroundColor=#ffffff;spacing=5;exitX=1;exitY=0.85;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="system" target="notify">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1250" y="547" />
                            <mxPoint x="1250" y="815" />
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e5" value="Одобренная выгрузка;&#10;теги, lineage, токенизация" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=17;labelBackgroundColor=#ffffff;spacing=5;" edge="1" parent="1" source="system" target="analytics">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="e6" value="Агрегаты по цели;&#10;без raw и таблицы токенов" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=17;labelBackgroundColor=#ffffff;spacing=5;" edge="1" parent="1" source="analyst" target="analytics">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram name="Защитные блоки и аналитические зоны">
        <mxGraphModel page="1" pageScale="1" pageWidth="2640" pageHeight="1540" grid="1" gridSize="10">
            <root>
                <mxCell id="0" />
                <mxCell id="1" parent="0" />
                <mxCell id="title" value="Защитные блоки и аналитические зоны&#10;Функциональная детализация системы записи и аналитики; границы размещения уточняются при реализации" style="whiteSpace=wrap;html=0;fontSize=24;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;shape=rectangle;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1">
                    <mxGeometry x="70" y="20" width="2500" height="100" as="geometry" />
                </mxCell>
                <mxCell id="iam" value="AD + IAM&#10;Личность, роли и сессии&#10;Учётные записи сотрудников&#10;и пациентов разделены" style="whiteSpace=wrap;html=0;fontSize=24;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=1;arcSize=8;fillColor=#eaf0f5;strokeColor=#456078;" vertex="1" parent="1">
                    <mxGeometry x="70" y="180" width="420" height="180" as="geometry" />
                </mxCell>
                <mxCell id="api" value="Порталы / API&#10;Серверная политика доступа&#10;Владелец, роль, филиал,&#10;лечебная связь; минимум полей" style="whiteSpace=wrap;html=0;fontSize=24;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=1;arcSize=8;fillColor=#eaf0f5;strokeColor=#456078;" vertex="1" parent="1">
                    <mxGeometry x="700" y="180" width="450" height="180" as="geometry" />
                </mxCell>
                <mxCell id="adapters" value="Адаптеры legacy&#10;Контракты к 1С и архиву&#10;Ограниченные сервисные права" style="whiteSpace=wrap;html=0;fontSize=24;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=1;arcSize=8;fillColor=#eaf0f5;strokeColor=#456078;" vertex="1" parent="1">
                    <mxGeometry x="1450" y="180" width="420" height="180" as="geometry" />
                </mxCell>
                <mxCell id="legacy" value="1С и файловый архив&#10;Учёт и медицинские документы&#10;Доступ через адаптеры" style="whiteSpace=wrap;html=0;fontSize=24;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=1;arcSize=8;fillColor=#eaf0f5;strokeColor=#456078;" vertex="1" parent="1">
                    <mxGeometry x="2150" y="180" width="420" height="180" as="geometry" />
                </mxCell>
                <mxCell id="keys" value="KMS и защищённые носители&#10;Ключи отдельно от данных&#10;Ротация и восстановление" style="whiteSpace=wrap;html=0;fontSize=24;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=1;arcSize=8;fillColor=#eaf0f5;strokeColor=#456078;" vertex="1" parent="1">
                    <mxGeometry x="70" y="600" width="420" height="180" as="geometry" />
                </mxCell>
                <mxCell id="operational" value="Домены PostgreSQL&#10;Контакты / расписание&#10;Медицинские / финансы отдельно&#10;Шифрование; роли / RLS" style="whiteSpace=wrap;html=0;fontSize=24;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;shape=cylinder3;boundedLbl=1;size=20;fillColor=#e8f0e8;strokeColor=#47664d;" vertex="1" parent="1">
                    <mxGeometry x="700" y="600" width="450" height="180" as="geometry" />
                </mxCell>
                <mxCell id="catalog" value="Каталог и политики&#10;Теги, цели, владельцы, сроки&#10;Источники; версии преобразований&#10;Lineage и версии правил" style="whiteSpace=wrap;html=0;fontSize=24;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;shape=cylinder3;boundedLbl=1;size=20;fillColor=#e8f0e8;strokeColor=#47664d;" vertex="1" parent="1">
                    <mxGeometry x="1450" y="600" width="420" height="180" as="geometry" />
                </mxCell>
                <mxCell id="audit" value="Аудит и мониторинг&#10;Кто, когда, объект и цель&#10;Алерты о нетипичных действиях&#10;Без PHI и полных медданных" style="whiteSpace=wrap;html=0;fontSize=24;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=1;arcSize=8;fillColor=#eaf0f5;strokeColor=#456078;" vertex="1" parent="1">
                    <mxGeometry x="2150" y="600" width="420" height="180" as="geometry" />
                </mxCell>
                <mxCell id="raw" value="Закрытый raw&#10;Карантин разрешённых выгрузок&#10;PII / PHI; доступ только ETL&#10;Шифрование носителей" style="whiteSpace=wrap;html=0;fontSize=24;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;shape=cylinder3;boundedLbl=1;size=20;fillColor=#e8f0e8;strokeColor=#47664d;" vertex="1" parent="1">
                    <mxGeometry x="700" y="1000" width="450" height="180" as="geometry" />
                </mxCell>
                <mxCell id="prep" value="Подготовленный слой&#10;Проверка; токенизация; lineage&#10;Таблица соответствий отдельно&#10;Шифрование носителей" style="whiteSpace=wrap;html=0;fontSize=24;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;shape=cylinder3;boundedLbl=1;size=20;fillColor=#e8f0e8;strokeColor=#47664d;" vertex="1" parent="1">
                    <mxGeometry x="1450" y="1000" width="420" height="180" as="geometry" />
                </mxCell>
                <mxCell id="mart" value="Агрегированная витрина&#10;Разрешённые признаки&#10;Проверка малых групп&#10;Шифрование; доступ по цели" style="whiteSpace=wrap;html=0;fontSize=24;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;shape=cylinder3;boundedLbl=1;size=20;fillColor=#e8f0e8;strokeColor=#47664d;" vertex="1" parent="1">
                    <mxGeometry x="2150" y="1000" width="420" height="180" as="geometry" />
