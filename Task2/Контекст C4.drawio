<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram name="C4 — первая версия системы записи">
    <mxGraphModel page="1" pageScale="1" pageWidth="1800" pageHeight="1200" grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Медикаменте: первая версия системы записи&#10;C4 / System Context" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;shape=rectangle;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1">
          <mxGeometry x="70" y="20" width="1600" height="100" as="geometry" />
        </mxCell>
        <mxCell id="patient" value="Пациент&#10;[Person]&#10;Записывается на приём&#10;и видит свои записи" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=0;fillColor=#f5eee1;strokeColor=#786448;" vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="staff" value="Ресепшен и врач&#10;[Person]&#10;Работают с данными&#10;в пределах своих прав" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=0;fillColor=#f5eee1;strokeColor=#786448;" vertex="1" parent="1">
          <mxGeometry x="60" y="570" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="system" value="Система записи&#10;[Software System]&#10;Порталы, расписание и контакты&#10;Проверка доступа на сервере&#10;Каталог правил и журнал действий" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=1;arcSize=8;fillColor=#eaf0f5;strokeColor=#456078;" vertex="1" parent="1">
          <mxGeometry x="650" y="360" width="470" height="220" as="geometry" />
        </mxCell>
        <mxCell id="iam" value="AD + IAM&#10;[External System]&#10;Вход сотрудников и пациентов" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=1;arcSize=8;fillColor=#eaf0f5;strokeColor=#456078;" vertex="1" parent="1">
          <mxGeometry x="1380" y="140" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="legacy" value="1С и файловый архив&#10;[External System]&#10;Учёт, документы&#10;и медицинские карты" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=1;arcSize=8;fillColor=#eaf0f5;strokeColor=#456078;" vertex="1" parent="1">
          <mxGeometry x="1380" y="420" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="notify" value="Каналы уведомлений&#10;[External System]&#10;Напоминание пациенту&#10;и специалисту за сутки" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=1;arcSize=8;fillColor=#eaf0f5;strokeColor=#456078;" vertex="1" parent="1">
          <mxGeometry x="1380" y="740" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="analyst" value="Аналитик&#10;[Person]&#10;Работает только&#10;с разрешённой витриной" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=0;fillColor=#f5eee1;strokeColor=#786448;" vertex="1" parent="1">
          <mxGeometry x="60" y="940" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="analytics" value="Защищённая аналитика&#10;[Software System]&#10;Сводные данные в первой версии;&#10;развитие аналитики поэтапно" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=1;arcSize=8;fillColor=#eaf0f5;strokeColor=#456078;" vertex="1" parent="1">
          <mxGeometry x="650" y="900" width="470" height="180" as="geometry" />
        </mxCell>
        <mxCell id="future" value="В течение года: мобильное приложение, CRM, подключение лаборатории и платёжного провайдера.&#10;Хранение и обработка данных — в инфраструктуре РФ." style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;shape=rectangle;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="1100" width="1670" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e0" value="Свои записи и нужные&#10;контакты; HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=17;labelBackgroundColor=#ffffff;spacing=5;" edge="1" parent="1" source="patient" target="system">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="Расписание по роли&#10;и филиалу; HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=17;labelBackgroundColor=#ffffff;spacing=5;" edge="1" parent="1" source="staff" target="system">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="Проверенный пользователь&#10;и его роли" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=17;labelBackgroundColor=#ffffff;spacing=5;exitX=0.85;exitY=0;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="system" target="iam">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1049.5" y="215" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" value="Через адаптеры:&#10;идентификаторы и статусы" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=17;labelBackgroundColor=#ffffff;spacing=5;exitX=1;exitY=0.5;entryX=0;entryY=0.3333333333333333;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="system" target="legacy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="Контакт и время приёма,&#10;без диагноза" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=17;labelBackgroundColor=#ffffff;spacing=5;exitX=1;exitY=0.85;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="system" target="notify">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1250" y="547" />
              <mxPoint x="1250" y="815" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" value="Разрешённая выгрузка; метки, история&#10;и замена идентификаторов" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=17;labelBackgroundColor=#ffffff;spacing=5;" edge="1" parent="1" source="system" target="analytics">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="Разрешённые сводные данные,&#10;без исходных файлов&#10;и таблицы кодов" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=17;labelBackgroundColor=#ffffff;spacing=5;" edge="1" parent="1" source="analyst" target="analytics">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Защита данных и подготовка аналитики">
    <mxGraphModel page="1" pageScale="1" pageWidth="2640" pageHeight="1540" grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Защита данных и подготовка аналитики&#10;Блоки показывают функции; размещение уточняется при реализации" style="whiteSpace=wrap;html=0;fontSize=24;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;shape=rectangle;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1">
          <mxGeometry x="70" y="20" width="2500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="iam" value="AD + IAM&#10;Пользователи, роли и сеансы&#10;Учётные записи сотрудников&#10;и пациентов разделены" style="whiteSpace=wrap;html=0;fontSize=24;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=1;arcSize=8;fillColor=#eaf0f5;strokeColor=#456078;" vertex="1" parent="1">
          <mxGeometry x="70" y="140" width="420" height="260" as="geometry" />
        </mxCell>
        <mxCell id="api" value="Порталы / API&#10;Проверка доступа на сервере&#10;Владелец, роль, филиал&#10;и участие врача в лечении&#10;Только нужные поля" style="whiteSpace=wrap;html=0;fontSize=24;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=1;arcSize=8;fillColor=#eaf0f5;strokeColor=#456078;" vertex="1" parent="1">
          <mxGeometry x="700" y="140" width="450" height="260" as="geometry" />
        </mxCell>
        <mxCell id="adapters" value="Адаптеры 1С и архива&#10;Обмен с ограниченными правами" style="whiteSpace=wrap;html=0;fontSize=24;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=1;arcSize=8;fillColor=#eaf0f5;strokeColor=#456078;" vertex="1" parent="1">
          <mxGeometry x="1450" y="140" width="420" height="260" as="geometry" />
        </mxCell>
        <mxCell id="legacy" value="1С и файловый архив&#10;Учёт и медицинские документы&#10;Доступ через адаптеры" style="whiteSpace=wrap;html=0;fontSize=24;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=1;arcSize=8;fillColor=#eaf0f5;strokeColor=#456078;" vertex="1" parent="1">
          <mxGeometry x="2150" y="140" width="420" height="260" as="geometry" />
        </mxCell>
        <mxCell id="keys" value="Ключи и шифрование&#10;Ключи отдельно от данных&#10;Смена и восстановление" style="whiteSpace=wrap;html=0;fontSize=24;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=1;arcSize=8;fillColor=#eaf0f5;strokeColor=#456078;" vertex="1" parent="1">
          <mxGeometry x="70" y="560" width="420" height="260" as="geometry" />
        </mxCell>
        <mxCell id="operational" value="Разделы данных PostgreSQL&#10;Контакты и расписание&#10;Медицинские и финансовые&#10;данные отдельно&#10;Шифрование и права доступа" style="whiteSpace=wrap;html=0;fontSize=24;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;shape=cylinder3;boundedLbl=1;size=20;fillColor=#e8f0e8;strokeColor=#47664d;" vertex="1" parent="1">
          <mxGeometry x="700" y="560" width="450" height="260" as="geometry" />
        </mxCell>
        <mxCell id="catalog" value="Каталог и правила&#10;Метки, цели, ответственные и сроки&#10;Источники и история&#10;преобразований" style="whiteSpace=wrap;html=0;fontSize=24;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;shape=cylinder3;boundedLbl=1;size=20;fillColor=#e8f0e8;strokeColor=#47664d;" vertex="1" parent="1">
          <mxGeometry x="1450" y="560" width="420" height="260" as="geometry" />
        </mxCell>
        <mxCell id="audit" value="Журнал действий и контроль работы&#10;Кто, когда и зачем&#10;обратился к данным&#10;Уведомления о необычных действиях&#10;Без медицинского содержания" style="whiteSpace=wrap;html=0;fontSize=24;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=1;arcSize=8;fillColor=#eaf0f5;strokeColor=#456078;" vertex="1" parent="1">
          <mxGeometry x="2150" y="560" width="420" height="260" as="geometry" />
        </mxCell>
        <mxCell id="raw" value="Исходные данные — закрытый доступ&#10;Разрешённые выгрузки&#10;через карантин&#10;Доступ только служебным процессам&#10;Шифрование" style="whiteSpace=wrap;html=0;fontSize=24;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;shape=cylinder3;boundedLbl=1;size=20;fillColor=#e8f0e8;strokeColor=#47664d;" vertex="1" parent="1">
          <mxGeometry x="700" y="960" width="450" height="260" as="geometry" />
        </mxCell>
        <mxCell id="prep" value="Подготовленные данные&#10;Проверка и замена&#10;идентификаторов кодами&#10;Таблица соответствий отдельно&#10;Шифрование" style="whiteSpace=wrap;html=0;fontSize=24;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;shape=cylinder3;boundedLbl=1;size=20;fillColor=#e8f0e8;strokeColor=#47664d;" vertex="1" parent="1">
          <mxGeometry x="1450" y="960" width="420" height="260" as="geometry" />
        </mxCell>
        <mxCell id="mart" value="Сводные данные для аналитики&#10;Разрешённые показатели&#10;Проверка маленьких групп&#10;Шифрование и доступ по цели" style="whiteSpace=wrap;html=0;fontSize=24;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;shape=cylinder3;boundedLbl=1;size=20;fillColor=#e8f0e8;strokeColor=#47664d;" vertex="1" parent="1">
          <mxGeometry x="2150" y="960" width="420" height="260" as="geometry" />
        </mxCell>
        <mxCell id="consumer" value="Отчёты и разрешённые задачи ML&#10;Только согласованные данные&#10;Без прямого доступа&#10;к исходным файлам" style="whiteSpace=wrap;html=0;fontSize=24;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=1;arcSize=8;fillColor=#eaf0f5;strokeColor=#456078;" vertex="1" parent="1">
          <mxGeometry x="2150" y="1320" width="420" height="180" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="Проверка доступа выполняется внутри API. Адаптеры входят в приложение. 1С и архив сохраняются как отдельные системы.&#10;Ключи используются для рабочих данных, аналитики и резервных копий.&#10;Журнал получает события приложения, подготовки данных и выдачи аналитики. Часть связей опущена для читаемости." style="whiteSpace=wrap;html=0;fontSize=24;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;shape=rectangle;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1">
          <mxGeometry x="70" y="1290" width="1900" height="210" as="geometry" />
        </mxCell>
        <mxCell id="iam-api" value="Пользователь, роли&#10;и сеанс" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=20;fontFamily=Arial;labelBackgroundColor=#ffffff;spacing=5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="iam" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="api-adapters" value="Разрешённые команды;&#10;идентификаторы и статусы" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=20;fontFamily=Arial;labelBackgroundColor=#ffffff;spacing=5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="api" target="adapters">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="adapters-legacy" value="Ограниченный доступ&#10;к операциям и файлам" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=20;fontFamily=Arial;labelBackgroundColor=#ffffff;spacing=5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="adapters" target="legacy">
