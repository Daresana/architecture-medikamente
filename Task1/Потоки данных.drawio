        <mxCell id="store" value="D1. PostgreSQL: расписание&#10;и контакты отдельно&#10;Шифрование; права доступа;&#10;резервные копии" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;shape=cylinder3;boundedLbl=1;size=20;fillColor=#e8f0e8;strokeColor=#47664d;" vertex="1" parent="1">
