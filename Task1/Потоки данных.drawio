                    <mxGeometry x="60" y="280" width="250" height="120" as="geometry" />
                </mxCell>
                <mxCell id="process" value="P1. Зарегистрировать&#10;и записать пациента" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=1;arcSize=8;fillColor=#eaf0f5;strokeColor=#456078;" vertex="1" parent="1">
