          <mxGeometry x="1300" y="610" width="290" height="120" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Персональные данные (PII).&#10;Для записи не нужны диагноз, адрес и место работы. Проверяются владелец записи и свободное время. Повтор запроса не создаёт дубль.&#10;Новые подключения используют TLS. Для существующих файловых связей выбирается совместимый защищённый способ передачи." style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;shape=rectangle;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1">
