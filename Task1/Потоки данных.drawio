                <mxCell id="store" value="D1. Excel записей&#10;и договоры на общем диске" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;shape=cylinder3;boundedLbl=1;size=20;fillColor=#e8f0e8;strokeColor=#47664d;" vertex="1" parent="1">
                    <mxGeometry x="1200" y="240" width="400" height="180" as="geometry" />
                </mxCell>
                <mxCell id="output" value="P2. Передать расписание" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=1;arcSize=8;fillColor=#eaf0f5;strokeColor=#456078;" vertex="1" parent="1">
                    <mxGeometry x="600" y="610" width="290" height="120" as="geometry" />
                </mxCell>
                <mxCell id="recipient" value="Ресепшен / врач" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;rounded=0;fillColor=#f5eee1;strokeColor=#786448;" vertex="1" parent="1">
                    <mxGeometry x="1300" y="610" width="290" height="120" as="geometry" />
                </mxCell>
                <mxCell id="note" value="Категории: PII; scheduling.&#10;Подтверждено: ручные файлы/1С, доменный вход; нет прикладного разграничения и аудита.&#10;Точный канал и дополнительные копии проверяются при инвентаризации." style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;shape=rectangle;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1">
                    <mxGeometry x="70" y="820" width="1650" height="140" as="geometry" />
                </mxCell>
                <mxCell id="e0" value="ФИО, контакт,&#10;специалист и время" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=17;labelBackgroundColor=#ffffff;spacing=5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="actor" target="process">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="e1" value="Записи и контакты&#10;Ручная запись" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=17;labelBackgroundColor=#ffffff;spacing=5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="process" target="store">
